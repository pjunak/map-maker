{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://map-maker.local/schemas/world/context-v4.schema.json",
  "title": "Map Maker spherical geographic context v4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "algorithm",
    "importer",
    "preparation",
    "input_sha256",
    "runtime",
    "settings",
    "grid",
    "areas_km2",
    "support",
    "water_bodies",
    "outputs",
    "context_sha256",
    "gateways",
    "shore_distance",
    "exposure",
    "connectivity"
  ],
  "properties": {
    "schema": {
      "const": "map-maker.world-context"
    },
    "version": {
      "const": 4
    },
    "algorithm": {
      "const": "spherical-geography-v5"
    },
    "importer": {
      "const": "retained-svg-v2"
    },
    "preparation": {
      "const": "bounded-world-v1"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "map_maker_version",
        "package_source_sha256",
        "python",
        "implementation",
        "platform",
        "machine",
        "byteorder",
        "geos",
        "gdal",
        "proj",
        "dependencies"
      ],
      "properties": {
        "map_maker_version": {
          "type": "string",
          "minLength": 1
        },
        "package_source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "python": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "machine": {
          "type": "string",
          "minLength": 1
        },
        "byteorder": {
          "enum": [
            "little",
            "big"
          ]
        },
        "geos": {
          "type": "string",
          "minLength": 1
        },
        "gdal": {
          "type": "string",
          "minLength": 1
        },
        "proj": {
          "type": "string",
          "minLength": 1
        },
        "dependencies": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "numpy",
            "Pillow",
            "shapely",
            "svgelements",
            "rasterio",
            "affine",
            "scipy"
          ],
          "properties": {
            "numpy": {
              "type": "string",
              "minLength": 1
            },
            "Pillow": {
              "type": "string",
              "minLength": 1
            },
            "shapely": {
              "type": "string",
              "minLength": 1
            },
            "svgelements": {
              "type": "string",
              "minLength": 1
            },
            "rasterio": {
              "type": "string",
              "minLength": 1
            },
            "affine": {
              "type": "string",
              "minLength": 1
            },
            "scipy": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude_cells"
      ],
      "properties": {
        "latitude_cells": {
          "type": "integer",
          "minimum": 4,
          "maximum": 360
        }
      }
    },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rows",
        "columns",
        "registration",
        "longitude_periodic",
        "pole_policy",
        "angular_step_deg",
        "north_south_spacing_km",
        "frame",
        "projection"
      ],
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 4,
          "maximum": 360
        },
        "columns": {
          "type": "integer",
          "minimum": 8,
          "maximum": 720
        },
        "registration": {
          "const": "cell-centre"
        },
        "longitude_periodic": {
          "const": true
        },
        "pole_policy": {
          "const": "finite-edge-gateways; no point-contact water links"
        },
        "angular_step_deg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "north_south_spacing_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "frame": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bounds",
            "radius_km",
            "central_meridian_deg"
          ],
          "properties": {
            "bounds": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 4,
              "maxItems": 4
            },
            "radius_km": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "central_meridian_deg": {
              "type": "number",
              "minimum": -180,
              "exclusiveMaximum": 180
            }
          }
        },
        "projection": {
          "const": "spherical-plate-carree"
        }
      }
    },
    "areas_km2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sphere",
        "land",
        "water",
        "land_conservation_error"
      ],
      "properties": {
        "sphere": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "land": {
          "type": "number",
          "minimum": 0
        },
        "water": {
          "type": "number",
          "minimum": 0
        },
        "land_conservation_error": {
          "type": "number"
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mixed_cells",
        "split_water_cells",
        "land_without_centre",
        "water_without_centre"
      ],
      "properties": {
        "mixed_cells": {
          "type": "integer",
          "minimum": 0
        },
        "split_water_cells": {
          "type": "integer",
          "minimum": 0
        },
        "land_without_centre": {
          "type": "integer",
          "minimum": 0
        },
        "water_without_centre": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "water_bodies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "area_km2",
          "crosses_seam",
          "displayed_cells"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "area_km2": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "crosses_seam": {
            "type": "boolean"
          },
          "displayed_cells": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input.world.json",
        "geography.npz",
        "land.png",
        "water.png",
        "support.png",
        "gateways.png",
        "exposure.npz",
        "shore-distance.png",
        "exposure-north.png",
        "exposure-support-north.png",
        "connectivity.npz",
        "connectivity.png"
      ],
      "properties": {
        "input.world.json": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "geography.npz": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "land.png": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "water.png": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "support.png": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "gateways.png": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "exposure.npz": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "shore-distance.png": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "exposure-north.png": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "exposure-support-north.png": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "connectivity.npz": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "connectivity.png": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sha256",
            "bytes"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "gateways": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement",
        "units",
        "east_seam",
        "south_pole",
        "positive_east_faces",
        "positive_south_faces"
      ],
      "properties": {
        "measurement": {
          "const": "longest-continuous-shared-edge-water-interval"
        },
        "units": {
          "const": "km"
        },
        "east_seam": {
          "const": "last-column-to-first; both-sides-open"
        },
        "south_pole": {
          "const": "zero-width; no-polar-links"
        },
        "positive_east_faces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 259200
        },
        "positive_south_faces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 258480
        }
      }
    },
    "shore_distance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement",
        "units",
        "includes_inland_water",
        "no_shoreline",
        "sample_count",
        "max_error_km"
      ],
      "properties": {
        "measurement": {
          "const": "cell-centre-to-nearest-sampled-shore"
        },
        "units": {
          "const": "km"
        },
        "includes_inland_water": {
          "const": true
        },
        "no_shoreline": {
          "const": "nan"
        },
        "sample_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500000
        },
        "max_error_km": {
          "type": "number",
          "minimum": 0,
          "maximum": 12.5
        }
      }
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measurement",
        "bearings",
        "range_km",
        "distance_samples",
        "sample_step_km",
        "weight",
        "mixed_support",
        "land_blocks_rays",
        "preview_bearing"
      ],
      "properties": {
        "measurement": {
          "const": "great-circle-weighted-water-fraction"
        },
        "bearings": {
          "const": [
            "N",
            "NE",
            "E",
            "SE",
            "S",
            "SW",
            "W",
            "NW"
          ]
        },
        "range_km": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3000
        },
        "distance_samples": {
          "type": "integer",
          "minimum": 32,
          "maximum": 256
        },
        "sample_step_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "weight": {
          "const": "exp(-3*distance/range); normalized-midpoints"
        },
        "mixed_support": {
          "const": "quadrature-weight-on-mixed-cells; not-error-bound"
        },
        "land_blocks_rays": {
          "const": false
        },
        "preview_bearing": {
          "const": "N"
        }
      }
    },
    "connectivity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "pieces",
        "links",
        "components",
        "split_cells",
        "registration",
        "links_policy",
        "interval_coordinates",
        "sample_coordinates",
        "area_units",
        "width_units",
        "fragmented_bodies",
        "fragmentation_policy"
      ],
      "properties": {
        "algorithm": {
          "const": "cell-water-pieces-v1"
        },
        "pieces": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500000
        },
        "links": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "components": {
          "type": "integer",
          "minimum": 0,
          "maximum": 500000
        },
        "split_cells": {
          "type": "integer",
          "minimum": 0,
          "maximum": 259200
        },
        "registration": {
          "const": "row-major-cell-offsets; zero-based-piece-indices"
        },
        "links_policy": {
          "const": "undirected-positive-intervals; east-and-south-once; periodic-east"
        },
        "interval_coordinates": {
          "const": "unit-face; east-north-to-south; south-west-to-east"
        },
        "sample_coordinates": {
          "const": "unit-source-frame; interior-sites-not-flow-paths"
        },
        "area_units": {
          "const": "km2"
        },
        "width_units": {
          "const": "km"
        },
        "fragmented_bodies": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "maxItems": 500000,
          "uniqueItems": true
        },
        "fragmentation_policy": {
          "const": "retain-pieces; no-inferred-links; transport-unsupported"
        }
      }
    }
  }
}
