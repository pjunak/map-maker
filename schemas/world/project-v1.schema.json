{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dmtools.local/schemas/world/project-v1.schema.json",
  "title": "DM Tools world project v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "importer",
    "preparation",
    "name",
    "source",
    "frame",
    "continents",
    "assignments"
  ],
  "properties": {
    "schema": {
      "const": "dmtools.world-project"
    },
    "version": {
      "const": 1
    },
    "importer": {
      "const": "retained-svg-v2"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "sha256",
        "svg"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "svg": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8388608
        }
      }
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projection",
        "bounds",
        "radius_km",
        "central_meridian_deg"
      ],
      "properties": {
        "projection": {
          "const": "plate-carree"
        },
        "bounds": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        },
        "radius_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "central_meridian_deg": {
          "type": "number",
          "minimum": -180,
          "exclusiveMaximum": 180
        }
      }
    },
    "coast_detail_km": {
      "description": "Optional. The drawn coast already carries detail down to this wavelength (km); regional maps add only finer coast detail.",
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1000
    },
    "continents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      }
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "feature_id",
          "continent_id",
          "role"
        ],
        "properties": {
          "feature_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "continent_id": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              {
                "type": "null"
              }
            ]
          },
          "role": {
            "enum": [
              "mainland",
              "island",
              "exclude"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "const": "exclude"
                }
              }
            },
            "then": {
              "properties": {
                "continent_id": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "continent_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        ]
      }
    },
    "preparation": {
      "const": "bounded-world-v1"
    }
  }
}
