{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dmtools.local/schemas/world/planet-region-v1.schema.json",
  "title": "DM Tools experimental regional planet detail v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "version", "status", "algorithm", "parent_build_sha256", "centre_lonlat_deg",
    "radius_km", "level", "pixels", "settings", "tile_store", "tiles", "crs_wkt", "outputs",
    "region_sha256"
  ],
  "properties": {
    "schema": { "const": "dmtools.planet-region" },
    "version": { "type": "integer", "const": 1 },
    "status": { "const": "experimental" },
    "algorithm": { "const": "planet-blended-tiles-v5" },
    "parent_build_sha256": { "$ref": "#/$defs/sha256" },
    "centre_lonlat_deg": {
      "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2
    },
    "radius_km": { "type": "number", "exclusiveMinimum": 0 },
    "level": { "type": "integer", "minimum": 1, "maximum": 3 },
    "pixels": { "type": "integer", "minimum": 64 },
    "settings": {
      "type": "object",
      "required": [
        "spacing_km", "process_area_km2", "calibration_iterations", "tile_km", "halo_km",
        "support_factor"
      ]
    },
    "tile_store": { "type": "string", "pattern": "^[0-9a-f]{24}$" },
    "tiles": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 1 },
    "crs_wkt": { "type": "string" },
    "outputs": {
      "type": "object",
      "required": ["elevation.tif", "relief.png"],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "bytes"],
        "properties": {
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "region_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": { "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
}
