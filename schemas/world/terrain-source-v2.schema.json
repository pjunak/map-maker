{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://map-maker.local/schemas/world/terrain-source-v2.schema.json",
  "title": "Map Maker world terrain source v2",
  "description": "Canonical metadata in a prepared SVG. Runtime also verifies visible paths, retained world identity, geometry, ownership, and physical scale.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "map-maker.world-terrain-source"
    },
    "version": {
      "const": 2
    },
    "model": {
      "const": "world-landmass-aeqd@2"
    },
    "world": {
      "$ref": "https://map-maker.local/schemas/world/project-v1.schema.json"
    },
    "world_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "requested_continent_id": {
      "type": "string",
      "minLength": 1
    },
    "included_continent_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "feature_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "axes": {
      "const": "projected-east-south-metres"
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "radius_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "longitude_deg": {
          "type": "number",
          "minimum": -180,
          "exclusiveMaximum": 180
        },
        "latitude_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "maximum_angle_deg": {
          "type": "number",
          "minimum": 0,
          "maximum": 80
        },
        "maximum_transverse_scale": {
          "type": "number",
          "minimum": 1,
          "maximum": 1.5
        },
        "curve_tolerance_m": {
          "const": 25
        },
        "source_step_deg": {
          "const": 0.25
        }
      },
      "required": [
        "radius_km",
        "longitude_deg",
        "latitude_deg",
        "maximum_angle_deg",
        "maximum_transverse_scale",
        "curve_tolerance_m",
        "source_step_deg"
      ]
    },
    "coastline": {
      "$ref": "urn:map-maker:schema:terrain-input-snapshot:4#/properties/coastline"
    },
    "geology": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model",
            "recipe"
          ],
          "properties": {
            "model": {
              "const": "explicit-geology-landforms@1"
            },
            "recipe": {
              "$ref": "https://map-maker.local/schemas/world/geology-v2.schema.json"
            }
          }
        }
      ]
    }
  },
  "required": [
    "schema",
    "version",
    "model",
    "world",
    "world_sha256",
    "requested_continent_id",
    "included_continent_ids",
    "feature_ids",
    "axes",
    "projection",
    "coastline",
    "geology"
  ]
}
