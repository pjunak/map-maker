{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dmtools.local/schemas/world/geology-v2.schema.json",
  "title": "DM Tools authored world geology v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "time_reference",
    "world_sha256",
    "world",
    "defaults",
    "provinces"
  ],
  "properties": {
    "schema": {
      "const": "dmtools.world-geology"
    },
    "version": {
      "const": 2,
      "type": "integer"
    },
    "time_reference": {
      "const": "Ma-before-common-present"
    },
    "world_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "world": {
      "$ref": "https://dmtools.local/schemas/world/project-v1.schema.json"
    },
    "defaults": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "continent_id",
          "profile"
        ],
        "properties": {
          "continent_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "profile": {
            "$ref": "#/$defs/profile"
          }
        }
      }
    },
    "provinces": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "priority",
          "vertices",
          "profile"
        ],
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 256,
            "pattern": "^province-[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "\\S"
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "vertices": {
            "type": "array",
            "minItems": 3,
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          },
          "profile": {
            "$ref": "#/$defs/profile"
          }
        }
      }
    },
    "landmarks": {
      "description": "Optional hand-placed wonders; recipes without it remain valid.",
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "kind",
          "position",
          "size_km"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^landmark-[A-Za-z0-9][A-Za-z0-9_-]*$",
            "maxLength": 256
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "kind": {
            "description": "A wonder kind from the catalog (domain.wonders).",
            "enum": [
              "titan",
              "shattered",
              "active",
              "crater",
              "chasm",
              "cliff",
              "tepui",
              "oasis",
              "fork"
            ]
          },
          "position": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "size_km": {
            "description": "What the kind's size measures (diameter, width or height); null uses the usual size and is the only value for kinds without a size.",
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0
          },
          "end": {
            "description": "The far end of a wonder placed by two ends; null for others.",
            "type": [
              "array",
              "null"
            ],
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "number"
            }
          },
          "age_myr": {
            "description": "Age (Myr) for the aging tool; null uses the planet's wonder age. Only craters, chasms, great cliffs and tepuis age.",
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 500
          }
        }
      }
    }
  },
  "$defs": {
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setting",
        "crust_age_ma",
        "rejuvenation_age_ma",
        "evolution_duration_ma",
        "landform"
      ],
      "properties": {
        "setting": {
          "enum": [
            "unspecified",
            "stable-interior",
            "active-belt",
            "rift",
            "volcanic",
            "sedimentary-basin"
          ]
        },
        "crust_age_ma": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000
        },
        "rejuvenation_age_ma": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000
        },
        "evolution_duration_ma": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1000000
        },
        "landform": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "urn:dmtools:schema:terrain-project:9#/$defs/landformSettings"
            }
          ]
        }
      }
    }
  }
}
