{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://map-maker.local/schemas/world/planet-build-v2.schema.json",
  "title": "Map Maker experimental whole-planet relief build v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "algorithms",
    "settings",
    "wonder_settings",
    "seed_policy",
    "stage_seeds",
    "inputs",
    "runtime",
    "compiled_kernels",
    "world_frame",
    "mesh",
    "raster",
    "calibration",
    "metrics",
    "climate",
    "rivers",
    "lakes",
    "volcanoes",
    "outputs",
    "base_sha256",
    "build_sha256"
  ],
  "properties": {
    "schema": { "const": "map-maker.planet-build" },
    "version": { "type": "integer", "const": 2 },
    "status": { "const": "experimental" },
    "algorithms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relief", "climate"],
      "properties": {
        "relief": { "const": "sphere-mesh-stream-power-v32" },
        "climate": { "enum": ["planet-climate-v7", null] }
      }
    },
    "settings": {
      "type": "object",
      "required": [
        "seed", "nodes", "duration_myr", "step_kyr", "erodibility", "area_exponent",
        "process_area_km2", "calibration_iterations", "climate_passes", "climate",
        "volcanic_islands"
      ],
      "properties": {
        "seed": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "nodes": { "type": "integer", "minimum": 2000, "maximum": 4000000 },
        "duration_myr": { "type": "number", "exclusiveMinimum": 0 },
        "step_kyr": { "type": "number", "exclusiveMinimum": 0 },
        "erodibility": { "type": "number", "exclusiveMinimum": 0 },
        "area_exponent": { "type": "number" },
        "process_area_km2": { "type": "number", "minimum": 0 },
        "calibration_iterations": { "type": "integer", "minimum": 0 },
        "climate_passes": { "type": "integer", "minimum": 0 },
        "climate": { "type": "object" },
        "volcanic_islands": { "type": "boolean" }
      }
    },
    "wonder_settings": {
      "description": "Wonders placed at random and the age of wonders without their own (ADR-0097).",
      "type": "object",
      "additionalProperties": false,
      "required": ["random", "age_myr"],
      "properties": {
        "random": {
          "description": "Wonder kinds placed at random where none of the kind is placed by hand.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "titan", "shattered", "active", "crater", "chasm", "cliff", "tepui", "oasis",
              "fork"
            ]
          }
        },
        "age_myr": { "type": "number", "minimum": 0, "maximum": 500 }
      }
    },
    "seed_policy": { "const": "named-stage-sha256@1" },
    "stage_seeds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planet.mesh", "planet.forcing", "planet.initial", "planet.volcanism"],
      "properties": {
        "planet.mesh": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "planet.forcing": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "planet.initial": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "planet.volcanism": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["world_sha256", "geology_sha256", "wonders_sha256"],
      "properties": {
        "world_sha256": { "$ref": "#/$defs/sha256" },
        "geology_sha256": { "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }] },
        "wonders_sha256": {
          "description": "Canonical hash of the hand-placed wonder document, copied as input.wonders.json.",
          "anyOf": [{ "$ref": "#/$defs/sha256" }, { "type": "null" }]
        }
      }
    },
    "runtime": { "type": "object" },
    "compiled_kernels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numba", "llvmlite"],
      "properties": { "numba": { "type": "string" }, "llvmlite": { "type": "string" } }
    },
    "world_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bounds", "radius_km", "central_meridian_deg"],
      "properties": {
        "bounds": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
        "radius_km": { "type": "number", "exclusiveMinimum": 0 },
        "central_meridian_deg": { "type": "number" }
      }
    },
    "mesh": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "triangles", "spacing_km", "authority"],
      "properties": {
        "nodes": { "type": "integer" },
        "triangles": { "type": "integer" },
        "spacing_km": { "type": "number" },
        "authority": { "type": "string" }
      }
    },
    "raster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height", "registration", "maps_to", "crs_wkt"],
      "properties": {
        "width": { "type": "integer", "minimum": 64 },
        "height": { "type": "integer", "minimum": 32 },
        "registration": { "const": "PixelIsArea" },
        "maps_to": { "type": "string" },
        "crs_wkt": { "type": "string" }
      }
    },
    "calibration": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "target_m", "measured_m", "scale"],
          "properties": {
            "name": { "type": "string" },
            "target_m": { "type": ["number", "null"] },
            "measured_m": { "type": ["number", "null"] },
            "scale": { "type": "number" }
          }
        }
      }
    },
    "metrics": { "type": "object" },
    "climate": { "type": ["object", "null"] },
    "rivers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threshold_km2", "threshold_m3_s", "features"],
      "properties": {
        "threshold_km2": { "type": "number", "exclusiveMinimum": 0 },
        "threshold_m3_s": { "type": "number", "exclusiveMinimum": 0 },
        "features": { "type": "integer", "minimum": 0 }
      }
    },
    "volcanoes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "active", "on_land", "islands", "island_area_km2", "by_kind", "by_setting"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "islands": { "type": "integer", "minimum": 0 },
        "island_area_km2": { "type": "number", "minimum": 0 },
        "active": { "type": "integer", "minimum": 0 },
        "on_land": { "type": "integer", "minimum": 0 },
        "by_kind": { "type": "object", "additionalProperties": { "type": "integer" } },
        "by_setting": { "type": "object", "additionalProperties": { "type": "integer" } }
      }
    },
    "lakes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "endorheic", "features"],
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "endorheic": { "type": "integer", "minimum": 0 },
        "features": { "type": "integer", "minimum": 0 }
      }
    },
    "outputs": {
      "type": "object",
      "required": [
        "input.world.json", "planet.npz", "elevation.tif", "relief.png",
        "rivers.geojson", "lakes.geojson", "volcanoes.geojson"
      ],
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sha256", "bytes"],
        "properties": {
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "base_sha256": {
      "description": "Identity of the planet without wonders (inputs, settings and runtime); regional tiles are cached under it.",
      "$ref": "#/$defs/sha256"
    },
    "build_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
