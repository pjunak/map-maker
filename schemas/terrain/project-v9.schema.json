{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:map-maker:schema:terrain-project:9",
  "title": "Map Maker terrain project version 9",
  "description": "Current authored inputs including an optional frozen world-context binding. Earlier project versions are unsupported.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "coastline",
    "settings",
    "constraints",
    "authoring",
    "world_context"
  ],
  "properties": {
    "schema": {
      "const": "map-maker.terrain-project"
    },
    "schema_version": {
      "const": 9
    },
    "coastline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "SVG path, resolved relative to the project document unless absolute."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "Fingerprint of the exact authoritative SVG bytes."
        }
      }
    },
    "settings": {
      "$ref": "#/$defs/generatorSettings"
    },
    "constraints": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/heightPoint"
          },
          {
            "$ref": "#/$defs/terrainBrush"
          },
          {
            "$ref": "#/$defs/ridge"
          },
          {
            "$ref": "#/$defs/valley"
          },
          {
            "$ref": "#/$defs/terrainRegion"
          },
          {
            "$ref": "#/$defs/lake"
          },
          {
            "$ref": "#/$defs/dry_basin"
          }
        ]
      }
    },
    "authoring": {
      "$ref": "#/$defs/authoringState"
    },
    "world_context": {
      "description": "Frozen geographic support bound to this local terrain frame, or null when the project has no world context.",
      "anyOf": [
        { "type": "null" },
        { "$ref": "urn:map-maker:schema:terrain-context:1#/$defs/binding" }
      ]
    }
  },
  "$defs": {
    "normalizedPoint": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "elevationMode": {
      "type": "string",
      "enum": [
        "absolute",
        "relative"
      ]
    },
    "generatorSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seed",
        "object_scale_km",
        "resolution_px",
        "maximum_elevation_m",
        "largest_feature_km",
        "detail_levels",
        "roughness",
        "coastal_rise_km",
        "variability",
        "drainage_density"
      ],
      "properties": {
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "object_scale_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "resolution_px": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096
        },
        "maximum_elevation_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "largest_feature_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "detail_levels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "roughness": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 1
        },
        "coastal_rise_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "variability": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "drainage_density": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 2.0,
          "description": "Automatic channel initiation multiplier: lower values form fewer channels; does not specify runoff or river width."
        }
      }
    },
    "heightPoint": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "elevation_mode": {
                "const": "absolute"
              }
            },
            "required": [
              "elevation_mode"
            ]
          },
          "then": {
            "properties": {
              "elevation_m": {
                "minimum": 0
              }
            }
          }
        }
      ],
      "required": [
        "type",
        "position",
        "elevation_mode",
        "elevation_m",
        "influence_radius_km"
      ],
      "properties": {
        "type": {
          "const": "height_point"
        },
        "position": {
          "$ref": "#/$defs/normalizedPoint"
        },
        "elevation_mode": {
          "$ref": "#/$defs/elevationMode"
        },
        "elevation_m": {
          "type": "number"
        },
        "influence_radius_km": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "terrainBrush": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "elevation_mode": {
                "const": "absolute"
              }
            },
            "required": [
              "elevation_mode"
            ]
          },
          "then": {
            "properties": {
              "elevation_m": {
                "minimum": 0
              }
            }
          }
        }
      ],
      "required": [
        "type",
        "points",
        "elevation_mode",
        "elevation_m",
        "influence_radius_km",
        "intensity"
      ],
      "properties": {
        "type": {
          "const": "terrain_brush"
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/normalizedPoint"
          }
        },
        "elevation_mode": {
          "$ref": "#/$defs/elevationMode"
        },
        "elevation_m": {
          "type": "number"
        },
        "influence_radius_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "intensity": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "ridge": {
      "$ref": "#/$defs/structureRidge"
    },
    "valley": {
      "$ref": "#/$defs/structureValley"
    },
    "structureRidge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "points",
        "elevation_mode",
        "elevation_m",
        "influence_radius_km",
        "profile"
      ],
      "properties": {
        "type": {
          "const": "ridge"
        },
        "points": {
          "type": "array",
          "minItems": 2,
          "items": {
            "$ref": "#/$defs/normalizedPoint"
          }
        },
        "elevation_mode": {
          "$ref": "#/$defs/elevationMode"
        },
        "elevation_m": {
          "type": "number",
          "minimum": 0
        },
        "influence_radius_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "profile": {
          "$ref": "#/$defs/structureProfile"
        }
      }
    },
    "structureValley": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "points",
        "elevation_mode",
        "elevation_m",
        "influence_radius_km",
        "profile"
      ],
      "properties": {
        "type": {
          "const": "valley"
        },
        "points": {
          "type": "array",
          "minItems": 2,
          "description": "Ordered from the upstream valley head toward the downstream outlet.",
          "items": {
            "$ref": "#/$defs/normalizedPoint"
          }
        },
        "elevation_mode": {
          "$ref": "#/$defs/elevationMode"
        },
        "elevation_m": {
          "type": "number",
          "minimum": 0,
          "description": "Absolute mode uses the downstream outlet floor; relative mode uses preferred incision depth."
        },
        "influence_radius_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "profile": {
          "$ref": "#/$defs/structureProfile"
        }
      }
    },
    "featureToolSettings": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "elevation_mode": {
                "const": "absolute"
              }
            },
            "required": [
              "elevation_mode"
            ]
          },
          "then": {
            "properties": {
              "elevation_m": {
                "minimum": 0
              }
            }
          }
        }
      ],
      "required": [
        "elevation_mode",
        "elevation_m",
        "radius_km"
      ],
      "properties": {
        "elevation_mode": {
          "$ref": "#/$defs/elevationMode"
        },
        "elevation_m": {
          "type": "number"
        },
        "radius_km": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "directionalFeatureToolSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elevation_mode",
        "elevation_m",
        "radius_km"
      ],
      "properties": {
        "elevation_mode": {
          "$ref": "#/$defs/elevationMode"
        },
        "elevation_m": {
          "type": "number",
          "minimum": 0
        },
        "radius_km": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "brushToolSettings": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "elevation_mode": {
                "const": "absolute"
              }
            },
            "required": [
              "elevation_mode"
            ]
          },
          "then": {
            "properties": {
              "elevation_m": {
                "minimum": 0
              }
            }
          }
        }
      ],
      "required": [
        "elevation_mode",
        "elevation_m",
        "width_km",
        "intensity"
      ],
      "properties": {
        "elevation_mode": {
          "$ref": "#/$defs/elevationMode"
        },
        "elevation_m": {
          "type": "number"
        },
        "width_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "intensity": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        }
      }
    },
    "authoringState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active_tool",
        "tools"
      ],
      "properties": {
        "active_tool": {
          "type": "string",
          "enum": [
            "brush",
            "height",
            "ridge",
            "valley",
            "region",
            "lake",
            "dry_basin"
          ]
        },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "brush",
            "height",
            "ridge",
            "valley",
            "region",
            "lake"
          ],
          "properties": {
            "brush": {
              "$ref": "#/$defs/brushToolSettings"
            },
            "height": {
              "$ref": "#/$defs/featureToolSettings"
            },
            "ridge": {
              "$ref": "#/$defs/directionalFeatureToolSettings"
            },
            "valley": {
              "$ref": "#/$defs/directionalFeatureToolSettings"
            },
            "region": {
              "$ref": "#/$defs/landformSettings"
            },
            "lake": {
              "$ref": "#/$defs/lakeToolSettings"
            }
          }
        }
      }
    },
    "landformSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "character",
        "elevation_m",
        "relief_m",
        "feature_size_km",
        "transition_km",
        "orientation_deg"
      ],
      "properties": {
        "character": {
          "enum": [
            "plain",
            "hills",
            "plateau",
            "mountains"
          ]
        },
        "elevation_m": {
          "type": "number",
          "minimum": 0
        },
        "relief_m": {
          "type": "number",
          "minimum": 0
        },
        "feature_size_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "transition_km": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "orientation_deg": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 180
        }
      }
    },
    "terrainRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "points",
        "settings",
        "holes"
      ],
      "properties": {
        "type": {
          "const": "terrain_region"
        },
        "points": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/normalizedPoint"
          }
        },
        "settings": {
          "$ref": "#/$defs/landformSettings"
        },
        "holes": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 4,
            "items": {
              "$ref": "#/$defs/normalizedPoint"
            }
          }
        }
      }
    },
    "lake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "points",
        "water_level_m",
        "outlet"
      ],
      "properties": {
        "type": {
          "const": "lake"
        },
        "points": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/normalizedPoint"
          }
        },
        "water_level_m": {
          "type": "number",
          "minimum": 0
        },
        "outlet": {
          "anyOf": [
            {
              "$ref": "#/$defs/normalizedPoint"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "dry_basin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "points",
        "water_level_m",
        "outlet"
      ],
      "properties": {
        "type": {
          "const": "dry_basin"
        },
        "points": {
          "type": "array",
          "minItems": 4,
          "items": {
            "$ref": "#/$defs/normalizedPoint"
          }
        },
        "water_level_m": {
          "type": "null"
        },
        "outlet": {
          "type": "null"
        }
      }
    },
    "lakeToolSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "water_level_m",
        "outlet_at_first_vertex"
      ],
      "properties": {
        "water_level_m": {
          "type": "number",
          "minimum": 0
        },
        "outlet_at_first_vertex": {
          "type": "boolean"
        }
      }
    },
    "structureProfile": {
      "description": "Empty for point-anchored defaults; otherwise 2-64 increasing knots from 0 to 1 along the smoothed metric centreline. Absolute valley heights cannot rise downstream. Runtime validates ordering and endpoints.",
      "type": "array",
      "maxItems": 64,
      "anyOf": [
        {
          "maxItems": 0
        },
        {
          "minItems": 2
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "position",
          "elevation_m"
        ],
        "properties": {
          "position": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "elevation_m": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    }
  }
}
